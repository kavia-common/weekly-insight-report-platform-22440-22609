# Backend Express - Supabase configuration
# IMPORTANT: Use the Service Role key for server-side operations (not anon).
SUPABASE_URL=https://your-project.supabase.co
# Preferred variable:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional legacy alias (fallback if SERVICE_ROLE_KEY not set):
# SUPABASE_KEY=your-service-role-key

# Optional diagnostics toggle (non-sensitive info in responses)
# DIAGNOSTICS=1

# Server host/port
# PORT=3000
# HOST=0.0.0.0
