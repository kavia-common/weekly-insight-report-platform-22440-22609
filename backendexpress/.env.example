# Copy this file to .env and fill in your Supabase project details.
# The server loads these at startup via dotenv (see src/server.js).

# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=

# Service Role key from Supabase (preferred; do NOT use anon key here)
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy alias supported by the codebase (prefer SUPABASE_SERVICE_ROLE_KEY)
# SUPABASE_KEY=

# App server settings (optional)
PORT=3000
HOST=0.0.0.0

# Optional diagnostics: set to 1 to include additional diag fields in certain responses
# DIAGNOSTICS=0
