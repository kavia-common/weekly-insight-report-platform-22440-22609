# Backend Express - Environment variables example
# Copy this file to ".env" and fill values as needed.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Optional diagnostics (when set to "1" repository may include extra diagnostic info in responses/logs)
# DIAGNOSTICS=1

# Supabase configuration
# REQUIRED for Supabase-backed features:
# - SUPABASE_URL: https://<your-project>.supabase.co
# - SUPABASE_SERVICE_ROLE_KEY: Service Role key (NOT anon key)
# Backward-compatible alias (discouraged): SUPABASE_KEY
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=

# Note: If SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY is not set,
# the service will start in "Supabase disabled" mode:
# - Read-only demo endpoints continue to work.
# - Supabase CRUD routes will return 503 with a helpful message.
# - /api/health/supabase will indicate configured=false with env *_present flags.

# Frontend-related variables (kept for consistency if shared build tooling references them)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=0
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=1
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/api/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=0
